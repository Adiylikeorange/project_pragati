# ============================================================
# PRAGATI Backend — Environment Variables
# ============================================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ============================================================

# Application
ENV=development
APP_NAME=PRAGATI
HOST=127.0.0.1
PORT=8000

# ── Database ─────────────────────────────────────────────────
# Local PostgreSQL example:
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/pragati

# Supabase (production) example:
# DATABASE_URL=postgresql://postgres.xxx:password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# ── Auth / JWT ────────────────────────────────────────────────
# Generate strong secrets: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_generate_a_strong_secret_key_here
JWT_SECRET=CHANGE_ME_generate_a_different_jwt_secret_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_RESET_EXPIRE_MINUTES=60

# ── CORS ──────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# ── Frontend URL (used in password reset emails) ──────────────
FRONTEND_URL=http://localhost:5173

# ── Email / SMTP ──────────────────────────────────────────────
# Set EMAIL_ENABLED=false to skip real emails (reset links printed to console)
EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM=noreply@pragati.gov.in

# ── Production overrides ──────────────────────────────────────
# When ENV=production:
#   - /docs and /redoc are disabled
#   - stack traces hidden from API responses
#   - ALLOWED_ORIGINS must include your real domain
# ENV=production
# ALLOWED_ORIGINS=https://pragati.yourdomain.com
# FRONTEND_URL=https://pragati.yourdomain.com
